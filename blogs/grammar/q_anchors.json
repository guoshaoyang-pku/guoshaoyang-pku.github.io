    {
      "id": "q_deepseek_v4",
      "source_id": "deepseek_v4",
      "name": "DeepSeek V4 Flash · Q",
      "kind": "自建Q版种子",
      "note": "8层；前2层滑窗，3/5/7层CSA，4/6/8层HCA；window32，CSA压缩4+index top16，HCA压缩32。保留mHC四流、hash前三层与动态路由后续层。 当前参考实现的indexer仅通过离散top-k选择，未接索引辅助训练损失；固定时间成绩会受参考算子实现效率影响。",
      "sources": [
        "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash/blob/main/config.json",
        "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash/blob/main/inference/model.py"
      ],
      "dependencies": [
        "torch"
      ],
      "status": "seed_unvalidated",
      "spec": {
        "vocab_size": 1024,
        "d_model": 128,
        "act": "silu",
        "forward": [
          {
            "layer_loop": {
              "iteration": 8,
              "residual": {
                "type": "mhc"
              },
              "body": [
                {
                  "type": "csa",
                  "n_heads": 4,
                  "head_dim": 64,
                  "q_rank": 32,
                  "o_rank": 32,
                  "o_groups": 2,
                  "rope_dim": 16,
                  "window": 32,
                  "compression": 4,
                  "indexer": {
                    "n_heads": 2,
                    "head_dim": 32,
                    "top_k": 16
                  }
                },
                {
                  "type": "sliding_attention",
                  "n_heads": 4,
                  "head_dim": 64,
                  "q_rank": 32,
                  "o_rank": 32,
                  "o_groups": 2,
                  "rope_dim": 16,
                  "window": 32,
                  "layers": [
                    1,
                    2
                  ]
                },
                {
                  "type": "hca",
                  "n_heads": 4,
                  "head_dim": 64,
                  "q_rank": 32,
                  "o_rank": 32,
                  "o_groups": 2,
                  "rope_dim": 16,
                  "window": 32,
                  "layers": "array(4,2)",
                  "compression": 32
                },
                {
                  "type": "moe",
                  "n_experts": 9,
                  "top_k": [
                    3,
                    1
                  ],
                  "expert": {
                    "hidden_dim": 128,
                    "gated": true
                  },
                  "router": {
                    "score": "sqrtsoftplus",
                    "scale": 1.5,
                    "hash_layers": [
                      1,
                      2,
                      3
                    ]
                  },
                  "swiglu_limit": 10
                }
              ]
            }
          },
          {
            "lm_head": {
              "tie_embedding": false
            }
          }
        ]
      },
      "search_policy": {
        "groups": [
          {
            "id": "moe",
            "scope": "/forward/0/layer_loop/body/3",
            "members": [
              "type",
              "n_experts",
              "top_k",
              "expert"
            ],
            "weak_lock": [
              "router",
              "swiglu_limit"
            ],
            "entry_weight": 0.05,
            "weak_weight": 0.1,
            "inner_steps": 4
          }
