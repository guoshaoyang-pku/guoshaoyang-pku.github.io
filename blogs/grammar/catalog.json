  "models": [
    {
      "id": "gpt2",
      "name": "GPT-2",
      "spec": {
        "vocab_size": 50257,
        "d_model": 768,
        "act": "gelu_new",
        "forward": [
          {
            "layer_loop": {
              "iteration": 12,
              "body": [
                {
                  "type": "attention",
                  "n_heads": 12
                },
                {
                  "type": "mlp",
                  "hidden_dim": 3072
                }
              ]
            }
          },
          {
            "lm_head": {
              "norm": "layer_norm"
            }
          }
        ],
        "norm": "pre_layer_norm"
      },
      "note": "保留主干宽度、层数和 Pre-LN；本版固定位置机制，未复刻原始绝对位置、bias/dropout。",
      "sources": [
        "https://huggingface.co/openai-community/gpt2/blob/main/config.json"
      ],
      "kind": "论文主干投影"
    },
    {
      "id": "rnn",
      "name": "MLP-RNN",
      "spec": {
        "vocab_size": 1024,
        "d_model": 256,
        "act": "tanh",
        "forward": [
          {
            "time_loop": {
              "state_dim": 256,
              "body": [
                {
                  "type": "mlp",
                  "input": [
                    "token",
                    "state"
                  ],
                  "merge": "concat",
                  "hidden_dim": 512,
                  "out_dim": 256,
                  "output": "state"
                }
              ]
            }
          },
          {
            "lm_head": {
              "tie_embedding": false,
              "norm": "none"
            }
          }
        ]
      },
      "note": "设计原型；time_loop 默认零状态、时间步共享、收集每步新状态。MLP 中间使用 act，最后线性输出。无 Transformer 残差。",
      "sources": [],
      "kind": "设计原型"
    },
    {
