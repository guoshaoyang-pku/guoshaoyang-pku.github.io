    {
      "id": "deepseek_v4",
      "name": "DeepSeek V4 · Flash",
      "spec": {
        "vocab_size": 129280,
        "d_model": 4096,
        "act": "silu",
        "forward": [
          {
            "layer_loop": {
              "iteration": 43,
              "residual": {
                "type": "mhc"
              },
              "body": [
                {
                  "type": "csa",
                  "n_heads": 64,
                  "head_dim": 512,
                  "q_rank": 1024,
                  "o_rank": 1024,
                  "o_groups": 8,
                  "rope_dim": 64,
                  "window": 128,
                  "compression": 4,
                  "indexer": {
                    "n_heads": 64,
                    "head_dim": 128,
                    "top_k": 512
                  }
                },
                {
                  "type": "sliding_attention",
                  "n_heads": 64,
                  "head_dim": 512,
                  "q_rank": 1024,
                  "o_rank": 1024,
                  "o_groups": 8,
                  "rope_dim": 64,
                  "window": 128,
                  "layers": [
                    1,
                    2
                  ]
                },
                {
                  "type": "hca",
                  "n_heads": 64,
                  "head_dim": 512,
                  "q_rank": 1024,
                  "o_rank": 1024,
                  "o_groups": 8,
                  "rope_dim": 64,
                  "window": 128,
                  "layers": "array(4,2)",
                  "compression": 128
                },
                {
                  "type": "moe",
                  "n_experts": 257,
                  "top_k": [
                    7,
                    1
                  ],
                  "expert": {
                    "hidden_dim": 2048,
                    "gated": true
                  },
                  "router": {
                    "score": "sqrtsoftplus",
                    "scale": 1.5,
                    "hash_layers": [
                      1,
                      2,
                      3
                    ]
                  },
                  "swiglu_limit": 10
                }
              ]
            }
          },
          {
            "lm_head": {
              "tie_embedding": false
            }
          }
        ]
      },
      "note": "43主干层；1–2滑窗，之后CSA(ratio4)与HCA(ratio128)交替。mHC默认4条流；前3层hash路由。未展开MTP、低精度执行和YaRN等配置；官方参考代码未启用本页share关系。主干eps固定1e-5与官方1e-6存在差异。",
      "sources": [
        "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash/blob/main/config.json",
        "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash/blob/main/inference/model.py"
      ],
      "kind": "论文主干投影",
      "search_policy": {
        "groups": [
          {
            "id": "moe",
            "scope": "/forward/0/layer_loop/body/3",
            "members": [
              "type",
              "n_experts",
              "top_k",
              "expert"
            ],
            "weak_lock": [
              "router",
              "swiglu_limit"
            ],
            "entry_weight": 0.05,
            "weak_weight": 0.1,
            "inner_steps": 4
          }
        ]
      }
    },
